# Copy this file to .env and fill in real values. .env is gitignored.
#
# OpenRouteService - free key from https://openrouteservice.org/dev/#/signup
# Used by the running route generator for round-trip routes and elevation.
#
# This must only ever be read on the server. Do not inline it into client
# JavaScript, and if the project moves to Next.js do NOT name it with a
# NEXT_PUBLIC_ prefix - that deliberately ships the value to the browser.
ORS_API_KEY=your-key-here

# Optional. Google Places API (New) - adds ratings, price and hours.
# Create a key at https://console.cloud.google.com/apis/credentials and enable
# "Places API (New)". Needs a billing account; restrict the key to that API.
GOOGLE_PLACES_API_KEY=your-key-here

# Optional. Yelp Fusion / Yelp Places API - second rating source.
# https://www.yelp.com/developers/v3/manage_app  (paid after the free trial)
YELP_API_KEY=your-key-here

# Optional. Claude API - only for the offline tool that labels restaurants'
# local specialties (python -m restaurants.tools.find_specialties). The site
# never calls Claude, so do not set this on Vercel.
# https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=your-key-here

# Restaurants: real data comes from OpenStreetMap (free, no key). Google and
# Yelp below are optional extras that add ratings and prices.
# 1 = use the bundled fictional demo data instead and never touch the network.
RESTAURANTS_MOCK=0

# Hours to keep Google/Yelp responses in .cache/ before asking again.
# Google's terms cap caching of most Places content at 30 days (720 h).
CACHE_TTL_HOURS=168
