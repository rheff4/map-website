# Copy this file to .env and fill in real values. .env is gitignored.
#
# OpenRouteService - free key from https://openrouteservice.org/dev/#/signup
# Used by the running route generator for round-trip routes and elevation.
#
# This must only ever be read on the server. Do not inline it into client
# JavaScript, and if the project moves to Next.js do NOT name it with a
# NEXT_PUBLIC_ prefix - that deliberately ships the value to the browser.
ORS_API_KEY=your-key-here
